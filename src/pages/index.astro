---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import OffTheClock from '../components/OffTheClock.astro';
import Icon from '../components/Icon.astro';
import { about, certificates, experience, site, socials } from '../data/site';
import { tools } from '../data/tools';

import avatar from '../assets/images/avatar.jpg';
import portrait from '../assets/images/portrait.jpg';
import landscape from '../assets/images/landscape.jpg';
import coastline from '../assets/images/coastline.jpg';
import ixdf from '../assets/certificates/ixdf.jpg';

const certImages = { ixdf };
const linkedin = socials.find((s) => s.icon === 'linkedin')!;

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<BaseLayout>
  <!-- Hero -->
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" data-reveal>
        Designer, creative thinker, and builder based in <em class="serif-italic">Indiana</em>.
      </h1>
      <p class="hero-sub" data-reveal style="--delay:.05s">Improving digital product experiences that feel right for the people who use them.</p>
      <div class="hero-actions" data-reveal style="--delay:.1s">
        <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" /> Let’s Work</a>
        <a class="btn btn-ghost" href={linkedin.href} target="_blank" rel="noopener"><Icon name="linkedin" /> Let’s Connect</a>
      </div>
    </div>

    <div class="hero-visual" data-reveal style="--delay:.1s">
      <div class="avatar">
        <Image src={avatar} alt="Portrait of Ahmad Abdullahi" widths={[320, 590]} sizes="(min-width: 900px) 360px, 62vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="section container" id="work" aria-labelledby="work-title">
    <div class="section-head work-head">
      <div>
        <h2 id="work-title">My Work</h2>
      </div>
    </div>

    <div class="tools-row">
      <p class="tools-label" id="tools-label">Tools I’ve used</p>
      <ul class="tools" aria-labelledby="tools-label">
        {tools.map((t, i) => (
          <li class="tool" title={t.name} data-reveal style={`--delay:${i * 0.04}s`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.path} /></svg>
            <span class="tool-name">{t.name}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="work-grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <!-- About -->
  <section class="section about-section" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="about-title">About Me</h2>
        </div>
      </div>

      <div class="bento">
        <article class="tile tile-story story-a" data-reveal>
          {about.story.slice(0, 2).map((para) => <p>{para}</p>)}
        </article>

        <figure class="tile tile-portrait" data-reveal style="--delay:.06s">
          <Image src={portrait} alt="Ahmad in a maroon sweater at an overlook above a lake, city and low clouds" widths={[500, 800, 1200, 1600]} sizes="(min-width: 900px) 600px, 100vw" />
        </figure>

        <article class="tile tile-story story-b" data-reveal>
          {about.story.slice(2).map((para) => <p>{para}</p>)}
        </article>

        <figure class="tile tile-coast" data-reveal style="--delay:.06s">
          <Image src={coastline} alt="Ahmad sitting on a grassy clifftop, looking out over the sea" widths={[400, 700, 1000]} sizes="(min-width: 900px) 400px, 100vw" />
        </figure>

        <article class="tile tile-now" data-reveal style="--delay:.12s">
          <p class="tile-label">Now</p>
          <p class="now-role">{site.current.role}</p>
          <p class="muted">{site.current.company}<br />Since {site.current.since}</p>
        </article>

        <article class="tile tile-edu" data-reveal>
          <p class="tile-label">Education</p>
          <p class="edu-degree">{about.education.degree}</p>
          <p class="muted">{about.education.school} · {about.education.year}</p>
          <p class="muted small">{about.education.detail}</p>
        </article>

        <figure class="tile tile-photo" data-reveal style="--delay:.12s">
          <Image src={landscape} alt="Mountain landscape overlooking a lake, photographed by Ahmad" widths={[500, 900, 1300]} sizes="(min-width: 900px) 500px, 100vw" />
          <figcaption>Shot on Canon EOS Rebel T7</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <OffTheClock />

  <!-- Experience -->
  <section class="section container" id="experience" aria-labelledby="exp-title">
    <div class="section-head">
      <div>
        <h2 id="exp-title">Experiences</h2>
      </div>
      <a class="btn btn-ghost" href={site.resume} target="_blank" rel="noopener"><Icon name="file" /> View resume</a>
    </div>

    <ol class="timeline">
      {experience.map((job, i) => (
        <li data-reveal style={`--delay:${i * 0.05}s`}>
          <span class="role">
            {job.role}
            {job.current && <span class="current">Current</span>}
          </span>
          <span class="company muted">{job.company}</span>
          <span class="dates muted">{job.dates}</span>
        </li>
      ))}
    </ol>

    <div class="certs-block">
      <h3 class="sub-label" id="cert-title">Certification</h3>
      <ul class="certs" aria-labelledby="cert-title">
        {certificates.map((c) => (
          <li data-reveal>
            <a class="cert" href={c.href} target="_blank" rel="noopener">
              <div class="cert-img">
                <Image src={certImages[c.image]} alt="" widths={[240, 480]} sizes="160px" />
              </div>
              <div class="cert-body">
                <p class="muted small">{c.issuer}</p>
                <p class="cert-title">{c.title}</p>
              </div>
              <span class="link-arrow">View certificate <Icon name="arrow-up-right" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  /* Hero ----------------------------------------------------------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    align-items: center;
    align-content: center;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    /* Fill the first screen (minus the header) so the next section
       only appears once the visitor starts scrolling */
    min-height: calc(100svh - 5rem);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  h1 {
    /* Sized so the headline sits on two lines on desktop */
    font-size: clamp(2.3rem, 1.5rem + 2.4vw, 3.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: initial;
  }

  .hero-sub {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  h1 em {
    color: var(--accent);
  }

  .hero-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 360px);
  }

  .avatar {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line), 0 0 0 10px var(--surface), 0 0 0 11px var(--line);
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  /* Hero buttons + tools under My Work ------------------------------ */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }

  .work-head {
    margin-bottom: 1.25rem;
  }

  .tools-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .tools-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1rem 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.2;
    transition: border-color 0.25s;
  }

  .tool:hover {
    border-color: var(--accent);
  }

  .tool svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: var(--ink);
  }

  /* Phones: label on its own line, tools shown as icons only */
  @media (max-width: 560px) {
    .tools-row {
      display: grid;
      gap: 0.75rem;
    }

    .tools {
      gap: 0.4rem;
    }

    .tool {
      width: 2.6rem;
      height: 2.6rem;
      padding: 0;
      justify-content: center;
    }

    .tool-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* Work ----------------------------------------------------------- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }

  /* About bento ---------------------------------------------------- */
  .about-section {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }

  .tile {
    margin: 0;
    padding: clamp(1.4rem, 1rem + 1.2vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
  }

  .tile h3 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }

  .tile p + p {
    margin-top: 0.4rem;
  }

  .tile-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .small {
    font-size: var(--step--1);
  }

  /* Row 1: paragraphs 1–2 + overlook portrait.
     Row 2: coastline photo + paragraph 3 (zigzag).
     Row 3: Now, Education, Canon photo. */
  .tile-story { display: flex; flex-direction: column; justify-content: center; }
  .story-a { grid-column: 1 / span 4; grid-row: 1; }
  .tile-portrait { grid-column: 5 / span 2; grid-row: 1; padding: 0; position: relative; min-height: 13rem; }
  .tile-coast { grid-column: 1 / span 2; grid-row: 2; padding: 0; position: relative; min-height: 20rem; }
  .story-b { grid-column: 3 / span 4; grid-row: 2; }
  .tile-now { grid-column: 1 / span 2; grid-row: 3; background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .tile-edu { grid-column: 3 / span 2; grid-row: 3; }
  .tile-photo { grid-column: 5 / span 2; grid-row: 3; padding: 0; position: relative; min-height: 13rem; }

  .tile-coast :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }

  .tile-story p {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .tile.tile-story p + p {
    margin-top: 1.1rem;
  }

  .tile-now .tile-label,
  .tile-now .muted {
    color: color-mix(in oklab, var(--on-ink) 65%, transparent);
  }

  .now-role,
  .edu-degree {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }

  /* Photos fill their tile without setting its height, so the text
     tiles beside them decide how tall each row is. */
  .tile-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Portrait fills its card; the focal point keeps Ahmad (on the
     right of the photo) in view at every card shape. */
  .tile-portrait :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 45%;
  }

  .tile-photo figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: var(--step--1);
    backdrop-filter: blur(8px);
  }

  /* Experience ----------------------------------------------------- */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .timeline li {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr) auto;
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.4s var(--ease), background-color 0.3s;
  }

  .timeline li:hover {
    padding-inline: 1rem;
    background: var(--surface);
  }

  .role {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .current {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 600 0.75rem/1.4 var(--font-body);
  }

  .dates {
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
    text-align: right;
  }

  /* Certification (inside Experience) ---------------------------- */
  .certs-block {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .sub-label {
    margin-bottom: 1rem;
    font: 700 0.72rem/1.2 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 0.75rem + 1.5vw, 2rem);
    padding: 0.9rem clamp(1rem, 0.8rem + 1vw, 1.75rem) 0.9rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.3s, box-shadow 0.4s var(--ease);
  }

  .cert:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .cert-img {
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .cert-img :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .cert-body {
    display: grid;
    gap: 0.3rem;
  }

  .cert-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  /* Responsive ----------------------------------------------------- */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-visual {
      order: -1;
      justify-self: center;
      width: min(62%, 280px);
    }

    .work-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }

    .tile-story,
    .tile-portrait,
    .tile-coast,
    .tile-edu {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .tile-coast {
      min-height: 0;
      aspect-ratio: 1;
    }

    .tile-now,
    .tile-photo {
      grid-column: span 1;
      grid-row: auto;
    }

    .tile-portrait {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .timeline li {
      grid-template-columns: minmax(0, 1fr);
    }

    .dates {
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .cert {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.6rem 1rem;
      padding-right: 1rem;
    }

    .cert .link-arrow {
      grid-column: 2;
    }

    .cert-img {
      grid-row: span 2;
      align-self: start;
      padding: 0.35rem;
    }

    .tile-now,
    .tile-photo {
      grid-column: 1 / -1;
    }

  }
</style>
