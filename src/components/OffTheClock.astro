---
import { Image } from 'astro:assets';
import { offTheClock as otc } from '../data/site';
import { url } from '../lib/url';
import cyberpunk from '../assets/images/cyberpunk-2077.jpg';

const tags = [
  { key: 'beats', label: 'Making beats' },
  { key: 'game', label: 'Gaming' },
  { key: 'bike', label: 'Biking' },
];
---
<section class="section container otc" id="off-the-clock" aria-labelledby="otc-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Off the clock</p>
      <h2 id="otc-title">What I’m into when I’m <em class="serif-italic">not designing</em></h2>
    </div>
  </div>

  <div class="chips" data-otc-chips>
    {tags.map((t) => <button class="chip" type="button" data-key={t.key}>{t.label}</button>)}
  </div>

  <div class="bento" data-otc-bento>
    <!-- Beats -->
    <article class="tile t-beats" data-key="beats" data-reveal>
      <div class="tile-top">
        <span class="label">Beats · made in FL Studio</span>
        <span class="mono muted">MP3</span>
      </div>
      <div class="screen">
        <canvas data-viz aria-hidden="true"></canvas>
        <p class="track">{otc.beat.title}</p>
      </div>
      <div class="controls">
        <button class="play" type="button" data-play aria-label={`Play ${otc.beat.title}`}>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
        </button>
        <input class="seek" type="range" min="0" max="1000" value="0" step="1" data-seek aria-label={`Seek within ${otc.beat.title}`} />
        <span class="time" data-time>0:00 / {otc.beat.duration}</span>
      </div>
      <audio data-audio src={url(otc.beat.src)} preload="metadata"></audio>
    </article>

    <!-- Gaming: currently playing + PC build -->
    <div class="side">
      <article class="tile t-game" data-key="game" data-reveal style="--delay:.06s">
        <span class="label">Currently playing</span>
        <div class="cover">
          <Image src={cyberpunk} alt={`${otc.game.title} cover art`} widths={[360, 560, 800]} sizes="(min-width: 900px) 320px, (min-width: 560px) 45vw, 100vw" />
        </div>
        <div class="game-meta">
          <h3>
            <a class="game-link" href={otc.game.href} target="_blank" rel="noopener">
              {otc.game.title} <span aria-hidden="true">↗</span>
            </a>
          </h3>
          <p class="pc-note">Playing on my own PC build ↓</p>
        </div>
      </article>

      <article class="tile t-pc" data-key="pc" data-group="game" data-reveal style="--delay:.1s">
        <span class="label">My PC build</span>
        <dl class="specs">
          {otc.pc.map((p) => (
            <div>
              <dt>{p.part}</dt>
              <dd>{p.name}</dd>
            </div>
          ))}
        </dl>
      </article>
    </div>

    <!-- Biking -->
    <article class="tile t-bike" data-key="bike" data-reveal>
      <div class="tile-top">
        <span class="label">On the bike · {otc.bike.trail}</span>
        <span class="mono muted">{otc.bike.city}</span>
      </div>
      <svg class="route" viewBox="0 -8 320 172" role="img" aria-label={`${otc.bike.trail} from ${otc.bike.from} north to Westfield, with the ${otc.bike.ridden} from ${otc.bike.from} to ${otc.bike.to} highlighted as ridden`}>
        <path class="trail-bg" d="M24 142 C 70 132, 80 106, 112 98 S 160 86, 182 70 S 222 50, 250 42 S 288 24, 300 16" />
        <path class="trail-rest" d="M24 142 C 70 132, 80 106, 112 98 S 160 86, 182 70 S 222 50, 250 42 S 288 24, 300 16" />
        <path class="trail" d="M24 142 C 70 132, 80 106, 112 98" />
        <circle class="stop" cx="24" cy="142" r="6" />
        <text x="18" y="160">{otc.bike.from}</text>
        <text class="flag" x="30" y="114">{otc.bike.segment}</text>
        <circle class="end" cx="112" cy="98" r="7" />
        <text x="122" y="116">{otc.bike.to}</text>
        <circle class="stop" cx="250" cy="42" r="4" />
        <text x="244" y="34" text-anchor="end">Carmel</text>
        <circle class="stop" cx="300" cy="16" r="4" />
        <text x="300" y="4" text-anchor="end">Westfield</text>
      </svg>
      <div class="stat">
        <b>{otc.bike.ridden}</b>
        <span>ridden so far</span>
      </div>
    </article>
  </div>
</section>

<script>
  const root = document.getElementById('off-the-clock');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Tags spotlight their card(s) ---- */
    const bento = root.querySelector<HTMLElement>('[data-otc-bento]')!;
    const tiles = [...bento.querySelectorAll<HTMLElement>('.tile')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    let clearTimer = 0;
    const spotlight = (key: string | null) => {
      bento.classList.toggle('focus', !!key);
      tiles.forEach((t) => t.classList.toggle('hit', !!key && (t.dataset.key === key || t.dataset.group === key)));
      chips.forEach((c) => c.classList.toggle('on', c.dataset.key === key));
    };
    chips.forEach((c) => {
      const key = c.dataset.key!;
      c.addEventListener('mouseenter', () => spotlight(key));
      c.addEventListener('mouseleave', () => spotlight(null));
      c.addEventListener('focus', () => spotlight(key));
      c.addEventListener('blur', () => spotlight(null));
      c.addEventListener('click', () => {
        bento.querySelector(`.tile[data-key="${key}"]`)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        spotlight(key);
        window.clearTimeout(clearTimer);
        clearTimer = window.setTimeout(() => spotlight(null), 1600);
      });
    });

    /* ---- Beat player + visualizer ---- */
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-seek]')!;
    const timeEl = root.querySelector<HTMLElement>('[data-time]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-viz]')!;
    const g = canvas.getContext('2d')!;
    const title = btn.getAttribute('aria-label')!.replace(/^Play /, '');

    const N = 56;
    const rest = Array.from({ length: N }, (_, i) => 0.16 + 0.5 * Math.abs(Math.sin(i * 0.9) * Math.cos(i * 0.31)));
    let levels = rest.slice();
    let actx: AudioContext | undefined;
    let analyser: AnalyserNode | undefined;
    let bins: Uint8Array<ArrayBuffer> | undefined;
    let raf = 0;
    let silentFrames = 0;
    let synthetic = false;
    let seeking = false;

    const fmt = (t: number) => {
      const s = Math.max(0, Math.floor(t || 0));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };

    const bar = (x: number, y: number, w: number, h: number, r: number) => {
      if (typeof g.roundRect === 'function') {
        g.beginPath();
        g.roundRect(x, y, w, h, r);
        g.fill();
      } else {
        g.fillRect(x, y, w, h);
      }
    };

    function draw() {
      const w = canvas.width;
      const h = canvas.height;
      const d = window.devicePixelRatio || 1;
      g.clearRect(0, 0, w, h);
      const slot = w / N;
      const bw = Math.max(2 * d, slot * 0.58);
      const mid = h * 0.58;
      const progress = audio.duration ? audio.currentTime / audio.duration : 0;
      for (let i = 0; i < N; i++) {
        const bh = Math.max(3 * d, levels[i] * h * 0.62);
        g.fillStyle = (i + 0.5) / N <= progress ? '#9fc0f0' : 'rgba(160, 172, 190, 0.32)';
        bar(i * slot + (slot - bw) / 2, mid - bh / 2, bw, bh, Math.min(bw / 2, 3 * d));
      }
    }

    function resize() {
      const r = canvas.getBoundingClientRect();
      const d = window.devicePixelRatio || 1;
      canvas.width = Math.max(1, Math.round(r.width * d));
      canvas.height = Math.max(1, Math.round(r.height * d));
      draw();
    }

    function frame() {
      if (!audio.paused && !reduce) {
        let target: number[];
        if (analyser && bins && !synthetic) {
          analyser.getByteFrequencyData(bins);
          let sum = 0;
          for (let k = 0; k < bins.length; k++) sum += bins[k];
          silentFrames = sum === 0 ? silentFrames + 1 : 0;
          if (silentFrames > 45 && audio.currentTime > 1) synthetic = true;
          const usable = Math.floor(bins.length * 0.62);
          const data = bins;
          target = Array.from({ length: N }, (_, i) => {
            const lo = Math.floor(Math.pow(i / N, 1.6) * usable);
            const hi = Math.max(lo + 1, Math.floor(Math.pow((i + 1) / N, 1.6) * usable));
            let m = 0;
            for (let k = lo; k < hi; k++) m = Math.max(m, data[k]);
            return 0.06 + (m / 255) * 0.94;
          });
        } else {
          // Fallback when the browser won't expose audio data
          const t = performance.now() / 1000;
          target = rest.map((r, i) => 0.1 + 0.9 * Math.abs(Math.sin(t * 3.1 + i * 0.55) * Math.cos(t * 1.7 + i * 0.21)) * (0.45 + r));
        }
        levels = levels.map((l, i) => Math.max(target[i], l * 0.86));
      } else {
        levels = levels.map((l, i) => l + (rest[i] - l) * 0.12);
      }
      draw();
      const settled = audio.paused && levels.every((l, i) => Math.abs(l - rest[i]) < 0.004);
      raf = settled ? 0 : requestAnimationFrame(frame);
    }
    const loop = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    function setupAnalyser() {
      if (actx) return;
      try {
        const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        actx = new Ctx();
        const src = actx.createMediaElementSource(audio);
        analyser = actx.createAnalyser();
        analyser.fftSize = 512;
        analyser.smoothingTimeConstant = 0.7;
        bins = new Uint8Array(analyser.frequencyBinCount);
        src.connect(analyser);
        analyser.connect(actx.destination);
      } catch {
        synthetic = true;
      }
    }

    const sync = () => {
      const playing = !audio.paused;
      btn.classList.toggle('is-playing', playing);
      btn.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} ${title}`);
    };

    btn.addEventListener('click', async () => {
      if (audio.paused) {
        setupAnalyser();
        try {
          if (actx && actx.state === 'suspended') await actx.resume();
        } catch {}
        try {
          await audio.play();
        } catch {
          timeEl.textContent = 'Couldn’t play audio';
        }
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => { sync(); loop(); });
    audio.addEventListener('pause', () => { sync(); loop(); });
    audio.addEventListener('ended', () => { audio.currentTime = 0; sync(); loop(); });
    audio.addEventListener('loadedmetadata', () => {
      timeEl.textContent = `0:00 / ${fmt(audio.duration)}`;
    });
    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
      if (!seeking) seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
      if (audio.paused) draw();
    });
    seek.addEventListener('input', () => {
      seeking = true;
      if (audio.duration) {
        audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
        draw();
      }
    });
    seek.addEventListener('change', () => { seeking = false; });

    new ResizeObserver(resize).observe(canvas);
    resize();
  }
</script>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 500 0.92rem/1.2 var(--font-body);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .chip::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .chip:hover,
  .chip.on {
    border-color: var(--accent);
  }

  .chip.on {
    background: var(--accent);
    color: var(--on-ink);
  }

  .chip.on::before {
    background: var(--on-ink);
    opacity: 1;
  }

  /* Grid ---------------------------------------------------------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }

  .tile {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: opacity 0.3s, border-color 0.3s, transform 0.4s var(--ease), box-shadow 0.4s;
  }

  .tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .bento.focus .tile {
    opacity: 0.35;
  }

  .bento.focus .tile.hit {
    opacity: 1;
    border-color: var(--accent);
  }

  .tile-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }

  .label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mono {
    font: 500 0.75rem/1.4 ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .t-beats {
    grid-column: span 4;
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-content: stretch;
  }

  .side {
    grid-column: span 2;
    display: grid;
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    align-content: start;
    min-width: 0;
  }

  .t-bike {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    align-items: center;
    column-gap: 2rem;
  }

  .t-bike .tile-top {
    grid-column: 1 / -1;
  }

  /* Beats ---------------------------------------------------------- */
  .screen {
    position: relative;
    min-height: 14rem;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: radial-gradient(120% 80% at 50% 110%, #1d2a40 0%, transparent 60%), #15171c;
  }

  .screen canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .track {
    position: absolute;
    left: 1rem;
    top: 0.8rem;
    color: #eceae4;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
  }

  .controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
  }

  .play {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-ink);
    cursor: pointer;
    transition: transform 0.3s var(--ease);
  }

  .play:hover {
    transform: scale(1.06);
  }

  .play svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .play .i-pause,
  .play.is-playing .i-play {
    display: none;
  }

  .play.is-playing .i-pause {
    display: block;
  }

  .seek {
    width: 100%;
    min-width: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .time {
    font: 500 0.75rem/1 ui-monospace, 'SF Mono', Menlo, monospace;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Gaming ---------------------------------------------------------- */
  .cover {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    background: #f3e600;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 27%;
    transition: transform 1s var(--ease);
  }

  .t-game:hover .cover :global(img) {
    transform: scale(1.04);
  }

  .game-meta {
    display: grid;
    gap: 0.25rem;
  }

  .game-meta h3 {
    font-size: var(--step-1);
  }

  .game-link {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease);
  }

  .game-link:hover,
  .game-link:focus-visible {
    background-size: 100% 1px;
  }

  .game-link span {
    font-size: 0.7em;
    color: var(--muted);
  }

  .pc-note {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .t-pc {
    gap: 0.5rem;
  }

  .specs {
    display: grid;
    margin: 0;
  }

  .specs div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    min-width: 0;
    padding: 0.5rem 0;
    border-top: 1px dashed var(--line);
  }

  .specs dt {
    font: 600 0.7rem/1.4 ui-monospace, 'SF Mono', Menlo, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .specs dd {
    margin: 0;
    font-weight: 600;
    transition: color 0.2s;
  }

  .specs div:hover dd {
    color: var(--accent);
  }

  /* Biking ---------------------------------------------------------- */
  .route {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    overflow: visible;
  }

  .route .trail-bg {
    fill: none;
    stroke: var(--line);
    stroke-width: 9;
    stroke-linecap: round;
  }

  .route .trail-rest {
    fill: none;
    stroke: color-mix(in oklab, var(--accent) 40%, var(--surface));
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 7;
  }

  .route .trail {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .route .stop {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .route .end {
    fill: var(--accent);
  }

  .route text {
    font: 600 10px var(--font-body);
    fill: var(--ink-soft);
  }

  .route text.flag {
    font: 700 10px ui-monospace, 'SF Mono', Menlo, monospace;
    fill: var(--accent);
  }

  .stat {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .stat b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Responsive ---------------------------------------------------------- */
  @media (max-width: 900px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }

    .t-beats,
    .side,
    .t-bike {
      grid-column: 1 / -1;
    }

    .screen {
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .t-game {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
    }

    .t-game .label {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .screen {
      aspect-ratio: 4 / 3;
    }

    .t-game,
    .t-bike {
      grid-template-columns: minmax(0, 1fr);
    }

    .route text {
      font-size: 14px;
    }

    .route text.flag {
      font-size: 12px;
    }
  }
</style>
