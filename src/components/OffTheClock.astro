---
import { Image } from 'astro:assets';
import { offTheClock as otc } from '../data/site';
import { url } from '../lib/url';
import cyberpunk from '../assets/images/cyberpunk-2077.jpg';
import flStudio from '../assets/images/fl-studio.jpg';

const tags = [
  { key: 'game', label: 'Gaming' },
  { key: 'beats', label: 'Making beats' },
  { key: 'active', label: 'Staying active' },
];

---
<section class="section container otc" id="off-the-clock" aria-labelledby="otc-title">
  <div class="section-head">
    <h2 id="otc-title">When I’m not designing</h2>
  </div>

  <div class="chips" data-otc-chips>
    {tags.map((t) => <button class="chip" type="button" data-key={t.key}>{t.label}</button>)}
  </div>

  <div class="bento" data-otc-bento>
    <!-- Gaming: cover art (left half) + PC build (right half) -->
    <article class="tile t-game" data-key="game" data-reveal>
      <Image src={cyberpunk} alt={`${otc.game.title} cover art`} widths={[480, 720, 1000]} sizes="(min-width: 900px) 600px, 100vw" />
      <div class="game-overlay">
        <span class="label">Currently playing</span>
        <h3>
          <a class="game-link" href={otc.game.href} target="_blank" rel="noopener">
            {otc.game.title} <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p class="pc-note">Playing on my own PC build <span class="arrow-side" aria-hidden="true">→</span><span class="arrow-down" aria-hidden="true">↓</span></p>
      </div>
    </article>

    <article class="tile t-pc" data-key="pc" data-group="game" data-reveal style="--delay:.06s">
      <span class="label">My PC build</span>
      <dl class="specs">
        {otc.pc.map((p) => (
          <div>
            <dt>{p.part}</dt>
            <dd>{p.name}</dd>
          </div>
        ))}
      </dl>
    </article>

    <!-- Beats: player card (left) + FL Studio image (right) -->
    <article class="tile t-beats" data-key="beats" data-reveal>
      <canvas data-viz aria-hidden="true"></canvas>
      <span class="visually-hidden" data-time aria-live="off">0:00 / {otc.beat.duration}</span>
      <div class="controls">
        <button class="play" type="button" data-play aria-label={`Play ${otc.beat.title}`}>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
        </button>
        <input class="seek" type="range" min="0" max="1000" value="0" step="1" data-seek aria-label={`Seek within ${otc.beat.title}`} />
      </div>
      <audio data-audio src={url(otc.beat.src)} preload="metadata"></audio>
    </article>

    <figure class="tile t-fl" data-key="fl" data-group="beats" data-reveal style="--delay:.06s">
      <Image src={flStudio} alt="FL Studio logo" widths={[480, 720, 1000]} sizes="(min-width: 760px) 600px, 100vw" />
    </figure>

    <!-- Staying active -->
    <div class="activities">
      {otc.activities.map((a, i) => (
        <article class="tile t-act" data-key="active" data-reveal style={`--delay:${i * 0.06}s`}>
          <span class="act-icon" aria-hidden="true">
            {a.icon === 'bike' && (
              <svg viewBox="0 0 24 24"><circle cx="5.5" cy="16.5" r="3.5" /><circle cx="18.5" cy="16.5" r="3.5" /><path d="M5.5 16.5 9 9.5h6.5l3 7M9 9.5l3.5 7h-7M15.5 9.5l-1.2-3H12" /></svg>
            )}
            {a.icon === 'run' && (
              <svg viewBox="0 0 24 24"><path d="M2.5 16.5V8.8c0-.7.6-1.1 1.2-.9l2.6 1c.9.3 1.9 0 2.4-.8L9.8 6l3.4 4.4c1.3 1.7 3.2 2.8 5.3 3.1l1.5.2c1.3.2 2.3 1.3 2.3 2.6v.2Z" /><path d="M2.5 16.5v1.2c0 .6.4 1 1 1h17.8c.6 0 1-.4 1-1v-1.2" /><path d="M10.6 9.6 12.2 8.4M12 11.3l1.7-1.2M13.7 12.8l1.6-1.1M2.5 13.5h4.2" /></svg>
            )}
            {a.icon === 'gym' && (
              <svg viewBox="0 0 24 24"><rect x="2.5" y="9" width="2.5" height="6" rx="1" /><rect x="5" y="6.5" width="3" height="11" rx="1" /><rect x="16" y="6.5" width="3" height="11" rx="1" /><rect x="19" y="9" width="2.5" height="6" rx="1" /><path d="M8 12h8" /></svg>
            )}
          </span>
          <h3>{a.label}</h3>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('off-the-clock');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Tags spotlight their card(s) ---- */
    const bento = root.querySelector<HTMLElement>('[data-otc-bento]')!;
    const tiles = [...bento.querySelectorAll<HTMLElement>('.tile')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    let clearTimer = 0;
    const spotlight = (key: string | null) => {
      bento.classList.toggle('focus', !!key);
      tiles.forEach((t) => t.classList.toggle('hit', !!key && (t.dataset.key === key || t.dataset.group === key)));
      chips.forEach((c) => c.classList.toggle('on', c.dataset.key === key));
    };
    chips.forEach((c) => {
      const key = c.dataset.key!;
      c.addEventListener('mouseenter', () => spotlight(key));
      c.addEventListener('mouseleave', () => spotlight(null));
      c.addEventListener('focus', () => spotlight(key));
      c.addEventListener('blur', () => spotlight(null));
      c.addEventListener('click', () => {
        bento.querySelector(`.tile[data-key="${key}"]`)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        spotlight(key);
        window.clearTimeout(clearTimer);
        clearTimer = window.setTimeout(() => spotlight(null), 1600);
      });
    });

    /* ---- Beat player + visualizer ---- */
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-seek]')!;
    const timeEl = root.querySelector<HTMLElement>('[data-time]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-viz]')!;
    const g = canvas.getContext('2d')!;
    const title = btn.getAttribute('aria-label')!.replace(/^Play /, '');

    let N = 64;
    const restLevel = (i: number) => 0.18 + 0.5 * Math.abs(Math.sin(i * 0.9) * Math.cos(i * 0.31));
    let rest = Array.from({ length: N }, (_, i) => restLevel(i));
    let levels = rest.slice();
    let actx: AudioContext | undefined;
    let analyser: AnalyserNode | undefined;
    let bins: Uint8Array<ArrayBuffer> | undefined;
    let raf = 0;
    let silentFrames = 0;
    let synthetic = false;
    let seeking = false;

    const fmt = (t: number) => {
      const s = Math.max(0, Math.floor(t || 0));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };

    const bar = (x: number, y: number, w: number, h: number, r: number) => {
      if (typeof g.roundRect === 'function') {
        g.beginPath();
        g.roundRect(x, y, w, h, r);
        g.fill();
      } else {
        g.fillRect(x, y, w, h);
      }
    };

    function draw() {
      const w = canvas.width;
      const h = canvas.height;
      const d = window.devicePixelRatio || 1;
      g.clearRect(0, 0, w, h);
      const slot = w / N;
      const bw = Math.max(2 * d, slot * 0.55);
      // Bars sit above the play controls, which overlay the bottom of the card
      const mid = h * 0.42;
      const progress = audio.duration ? audio.currentTime / audio.duration : 0;
      for (let i = 0; i < N; i++) {
        const bh = Math.max(3 * d, levels[i] * h * 0.6);
        g.fillStyle = (i + 0.5) / N <= progress ? '#9fc0f0' : 'rgba(160, 172, 190, 0.32)';
        bar(i * slot + (slot - bw) / 2, mid - bh / 2, bw, bh, Math.min(bw / 2, 2 * d));
      }
    }

    function resize() {
      const r = canvas.getBoundingClientRect();
      const d = window.devicePixelRatio || 1;
      canvas.width = Math.max(1, Math.round(r.width * d));
      canvas.height = Math.max(1, Math.round(r.height * d));
      // Fewer, chunkier bars on narrow screens
      const next = Math.max(28, Math.min(96, Math.round(r.width / 9)));
      if (next !== N) {
        N = next;
        rest = Array.from({ length: N }, (_, i) => restLevel(i));
        levels = rest.slice();
      }
      draw();
    }

    function frame() {
      if (!audio.paused && !reduce) {
        let target: number[];
        if (analyser && bins && !synthetic) {
          analyser.getByteFrequencyData(bins);
          let sum = 0;
          for (let k = 0; k < bins.length; k++) sum += bins[k];
          silentFrames = sum === 0 ? silentFrames + 1 : 0;
          if (silentFrames > 45 && audio.currentTime > 1) synthetic = true;
          const usable = Math.floor(bins.length * 0.62);
          const data = bins;
          target = Array.from({ length: N }, (_, i) => {
            const lo = Math.floor(Math.pow(i / N, 1.6) * usable);
            const hi = Math.max(lo + 1, Math.floor(Math.pow((i + 1) / N, 1.6) * usable));
            let m = 0;
            for (let k = lo; k < hi; k++) m = Math.max(m, data[k]);
            return 0.06 + (m / 255) * 0.94;
          });
        } else {
          // Fallback when the browser won't expose audio data
          const t = performance.now() / 1000;
          target = rest.map((r, i) => 0.1 + 0.9 * Math.abs(Math.sin(t * 3.1 + i * 0.55) * Math.cos(t * 1.7 + i * 0.21)) * (0.45 + r));
        }
        levels = levels.map((l, i) => Math.max(target[i], l * 0.86));
      } else {
        levels = levels.map((l, i) => l + (rest[i] - l) * 0.12);
      }
      draw();
      const settled = audio.paused && levels.every((l, i) => Math.abs(l - rest[i]) < 0.004);
      raf = settled ? 0 : requestAnimationFrame(frame);
    }
    const loop = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    function setupAnalyser() {
      if (actx) return;
      try {
        const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        actx = new Ctx();
        const src = actx.createMediaElementSource(audio);
        analyser = actx.createAnalyser();
        analyser.fftSize = 512;
        analyser.smoothingTimeConstant = 0.7;
        bins = new Uint8Array(analyser.frequencyBinCount);
        src.connect(analyser);
        analyser.connect(actx.destination);
      } catch {
        synthetic = true;
      }
    }

    const sync = () => {
      const playing = !audio.paused;
      btn.classList.toggle('is-playing', playing);
      btn.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} ${title}`);
    };

    btn.addEventListener('click', async () => {
      if (audio.paused) {
        setupAnalyser();
        try {
          if (actx && actx.state === 'suspended') await actx.resume();
        } catch {}
        try {
          await audio.play();
        } catch {
          timeEl.textContent = 'Couldn’t play audio';
        }
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => { sync(); loop(); });
    audio.addEventListener('pause', () => { sync(); loop(); });
    audio.addEventListener('ended', () => { audio.currentTime = 0; sync(); loop(); });
    audio.addEventListener('loadedmetadata', () => {
      timeEl.textContent = `0:00 / ${fmt(audio.duration)}`;
    });
    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
      if (!seeking) seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
      if (audio.paused) draw();
    });
    seek.addEventListener('input', () => {
      seeking = true;
      if (audio.duration) {
        audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
        draw();
      }
    });
    seek.addEventListener('change', () => { seeking = false; });

    new ResizeObserver(resize).observe(canvas);
    resize();
  }
</script>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 500 0.92rem/1.2 var(--font-body);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .chip::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .chip:hover,
  .chip.on {
    border-color: var(--accent);
  }

  .chip.on {
    background: var(--accent);
    color: var(--on-ink);
  }

  .chip.on::before {
    background: var(--on-ink);
    opacity: 1;
  }

  /* Grid: gaming row (two halves), beats row (two halves), then activities */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }

  .tile {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: opacity 0.3s, border-color 0.3s, transform 0.4s var(--ease), box-shadow 0.4s;
  }

  .tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .bento.focus .tile {
    opacity: 0.35;
  }

  .bento.focus .tile.hit {
    opacity: 1;
    border-color: var(--accent);
  }

  .activities {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }

  .tile-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }

  .label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mono {
    font: 500 0.75rem/1.4 ui-monospace, 'SF Mono', Menlo, monospace;
  }

  /* Gaming ---------------------------------------------------------- */
  .t-game {
    position: relative;
    overflow: hidden;
    padding: 0;
    min-height: 19rem;
    align-content: end;
    background: #111;
    border-color: transparent;
  }

  .t-game :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    transition: transform 1s var(--ease);
  }

  .t-game:hover :global(img) {
    transform: scale(1.04);
  }

  .game-overlay {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 3.5rem clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem) clamp(1rem, 0.8rem + 0.8vw, 1.4rem);
    background: linear-gradient(to top, rgb(8 9 12 / 0.94) 0%, rgb(8 9 12 / 0.8) 45%, transparent 100%);
    color: #f6f3ec;
  }

  .game-overlay .label {
    color: rgb(246 243 236 / 0.75);
  }

  .game-overlay h3 {
    font-size: var(--step-2);
    color: #fff;
  }

  .game-link {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease);
  }

  .game-link:hover,
  .game-link:focus-visible {
    background-size: 100% 1px;
  }

  .game-link span {
    font-size: 0.65em;
    opacity: 0.75;
  }

  .pc-note {
    font-size: 0.85rem;
    color: rgb(246 243 236 / 0.75);
  }

  .arrow-down {
    display: none;
  }

  .t-pc {
    gap: 0.5rem;
    align-content: center;
  }

  .specs {
    display: grid;
    margin: 0;
  }

  .specs div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    min-width: 0;
    padding: 0.6rem 0;
    border-top: 1px dashed var(--line);
  }

  .specs dt {
    font: 600 0.7rem/1.4 ui-monospace, 'SF Mono', Menlo, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .specs dd {
    margin: 0;
    font-weight: 600;
    transition: color 0.2s;
  }

  .specs div:hover dd {
    color: var(--accent);
  }

  /* Beats ---------------------------------------------------------- */
  .t-beats {
    position: relative;
    overflow: hidden;
    min-height: 18rem;
    padding: 0;
    align-content: end;
    background: radial-gradient(120% 80% at 50% 110%, #1d2a40 0%, transparent 60%), #15171c;
    border-color: transparent;
  }

  .t-beats canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .controls {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    padding: 1rem clamp(1rem, 0.8rem + 0.8vw, 1.4rem);
    background: linear-gradient(to top, rgb(10 12 16 / 0.85), transparent);
  }

  .play {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: #f2efe7;
    color: #15171c;
    cursor: pointer;
    transition: transform 0.3s var(--ease);
  }

  .play:hover {
    transform: scale(1.06);
  }

  .play svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .play .i-pause,
  .play.is-playing .i-play {
    display: none;
  }

  .play.is-playing .i-pause {
    display: block;
  }

  .seek {
    width: 100%;
    min-width: 0;
    margin: 0;
    accent-color: #9fc0f0;
    cursor: pointer;
  }

  .t-fl {
    position: relative;
    overflow: hidden;
    padding: 0;
    margin: 0;
    min-height: 18rem;
    background: #34495a;
    border-color: transparent;
  }

  .t-fl :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }

  .t-fl:hover :global(img) {
    transform: scale(1.04);
  }

  /* Staying active ---------------------------------------------------- */
  .t-act {
    justify-items: center;
    align-content: start;
    gap: 0.85rem;
    padding-block: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    text-align: center;
  }

  .act-icon {
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .act-icon svg {
    width: clamp(4rem, 2.5rem + 5vw, 7.5rem);
    height: auto;
    aspect-ratio: 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .t-act h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  /* Responsive ---------------------------------------------------------- */
  @media (max-width: 760px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }

    .t-game {
      min-height: 0;
      aspect-ratio: 16 / 11;
    }

    .arrow-side {
      display: none;
    }

    .arrow-down {
      display: inline;
    }
  }

  @media (max-width: 760px) {
    .t-fl {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .t-beats {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 560px) {
    .activities {
      gap: 0.6rem;
    }

    .t-act {
      padding: 1.1rem 0.6rem;
    }

    .act-icon svg {
      width: 3.6rem;
      stroke-width: 1.5;
    }

    .t-act h3 {
      font-size: 1rem;
    }
  }
</style>
