---
import { nav, site } from '../data/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <div class="top">
      <div>
        <a class="name" href={url('/')}>{site.name}</a>
        <p class="muted">{site.role} based in {site.location}.</p>
      </div>
      <nav aria-label="Footer">
        {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
        <a href={site.resume} target="_blank" rel="noopener">Resume</a>
      </nav>
    </div>
    <div class="bottom muted">
      <span>© {year} {site.name}</span>
      <a href={url('/licensing')}>Credits &amp; licensing</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 3.5rem 2rem;
    font-size: 0.95rem;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration: none;
  }

  .top p {
    margin-top: 0.4rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.5rem;
  }

  nav a,
  .bottom a {
    text-decoration: none;
  }

  nav a:hover,
  .bottom a:hover {
    text-decoration: underline;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  @media (max-width: 760px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
