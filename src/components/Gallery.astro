---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;
---
<div class:list={['gallery', `n${images.length}`]}>
  {images.map((img, i) => (
    <figure>
      <Image
        src={img}
        alt={`${alt} (${i + 1} of ${images.length})`}
        widths={[480, 800, 1200, 1800]}
        sizes={images.length === 3 && i === 0 ? '(min-width: 1280px) 1200px, 100vw' : '(min-width: 1280px) 600px, (min-width: 700px) 50vw, 100vw'}
        loading="lazy"
      />
    </figure>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    margin-block: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .n3 figure:first-child {
    grid-column: 1 / -1;
  }

  figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .n2 figure {
    aspect-ratio: 16 / 11;
  }

  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
