---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
  index?: number;
}

const { project, featured = false, index = 0 } = Astro.props;
const { title, subtitle, hero, heroAlt, year, role, industry } = project.data;
const href = url(`/projects/${project.id}`);
---
<article class:list={['card', { featured }]} data-reveal style={`--delay:${(index % 2) * 0.08}s`}>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={hero}
      alt={heroAlt}
      widths={featured ? [640, 1000, 1400, 2000] : [480, 800, 1200]}
      sizes={featured ? '(min-width: 1280px) 1200px, 100vw' : '(min-width: 900px) 600px, 100vw'}
      loading={index === 0 ? 'eager' : 'lazy'}
      style={`view-transition-name: hero-${project.id}`}
    />
    <span class="pill">View case study <Icon name="arrow-up-right" /></span>
  </a>
  <div class="body">
    <div class="meta">
      <span class="chip">{year}</span>
      <span class="chip">{role}</span>
      <span class="chip hide-sm">{industry}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="muted">{subtitle}</p>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.4rem;
  }

  .media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
  }

  .featured .media {
    aspect-ratio: 16 / 8;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 1.1s var(--ease);
  }

  .card:hover .media :global(img) {
    transform: scale(1.035);
  }

  .pill {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .pill :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .card:hover .pill,
  .card:focus-within .pill {
    opacity: 1;
    transform: none;
  }

  .body {
    display: grid;
    gap: 0.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  h3 {
    font-size: var(--step-2);
  }

  .featured h3 {
    font-size: var(--step-3);
  }

  h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease);
  }

  .card:hover h3 a {
    background-size: 100% 1px;
  }

  .body p {
    max-width: 60ch;
  }

  .featured .body {
    grid-template-columns: 1fr 1fr;
    align-items: end;
    column-gap: 3rem;
  }

  .featured .meta {
    grid-column: 1 / -1;
  }

  @media (max-width: 760px) {
    .featured .body {
      grid-template-columns: 1fr;
    }

    .featured .media {
      aspect-ratio: 16 / 10;
    }

    .hide-sm {
      display: none;
    }
  }

  @media (hover: none) {
    .pill {
      opacity: 1;
      transform: none;
    }
  }
</style>
